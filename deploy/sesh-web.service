[Unit]
Description=Sesh web application (gunicorn)
After=network.target postgresql.service

[Service]
User=sesh
Group=sesh
WorkingDirectory=/opt/sesh
EnvironmentFile=/etc/sesh/sesh.env
ExecStart=/opt/sesh/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
