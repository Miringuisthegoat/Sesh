# Copy to .env and edit. NEVER commit .env. All values below are placeholders.
ENVIRONMENT=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
# Leave DATABASE_URL empty in development to use a local SQLite file (instance/sesh.db)
DATABASE_URL=
# Postgres example: postgresql+psycopg://sesh_user:CHANGE_ME@localhost:5432/sesh

# Upload / policy
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=docx,xlsx,jpg,jpeg,png
RETENTION_DAYS_DEFAULT=90

# Agent / jobs
AGENT_HEARTBEAT_SECONDS=30
AGENT_OFFLINE_AFTER_SECONDS=90
JOB_LEASE_SECONDS=120
MAX_CONVERSION_RETRIES=3
MAX_JOB_ATTEMPTS=3                 # times a print job may be claimed before failing as AGENT_LOST
MAX_PENDING_JOBS_PER_USER=20

# MVP limits (raise later for multi-office support)
MAX_OFFICES_PER_COMPANY=1
MAX_ACTIVE_AGENTS_PER_OFFICE=1
MAX_ACTIVE_PRINTERS_PER_OFFICE=1

# Security
PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT=10 per minute
SESSION_HOURS=12
TRUSTED_PROXY_COUNT=0              # set to 1 behind Nginx so client IPs are correct
RATELIMIT_STORAGE_URI=memory://    # use redis://localhost:6379/1 in production

# Storage
STORAGE_BACKEND=local              # local | r2
STORAGE_LOCAL_PATH=storage
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Documents / conversion
UPLOAD_RATE_LIMIT=20 per minute
MAX_IMAGE_PIXELS=50000000
CONVERSION_LEASE_SECONDS=600       # a conversion stuck in PROCESSING longer than this is retried
WORKER_POLL_SECONDS=2
MAX_PREVIEW_PAGES=30
PREVIEW_WIDTH_PX=900

# Background jobs (the worker uses the database queue; REDIS_URL is only needed for rate limiting in production)
REDIS_URL=redis://localhost:6379/0
AGENT_ENROLLMENT_HOURS=24           # how long an enrolment token stays valid
AGENT_REGISTER_RATE_LIMIT=10 per minute
